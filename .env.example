# Artifex Configuration
# Copy to .env and customize

# REQUIRED in production — random string for JWT signing
JWT_SECRET=change-me-to-a-random-string

# Instance identity (shown to federated peers)
INSTANCE_NAME=My Artifex Gallery
PUBLIC_URL=https://gallery.example.com

# Federation — allow other instances to sync your public images' metadata and
# let their users load your media directly (peers must be reachable from the
# viewer's browser; use matching http/https schemes across peers)
FEDERATION_ENABLED=true

# Discovery — opt in to being listed on a public Artifex directory so others
# can find and add this instance (first-boot seed; toggle later in Admin).
# Requires PUBLIC_URL to be reachable by the directory.
DISCOVERY_ENABLED=false
# The directory to register with and browse (see directory/ for self-hosting)
DIRECTORY_URL=

# CORS — comma-separated allowed origins (empty = allow all in development)
ALLOWED_ORIGINS=

# Storage quota per user in bytes (default 5GB)
DEFAULT_STORAGE_QUOTA=5368709120

# Logging level: error, warn, info, debug
LOG_LEVEL=info

# Server port
PORT=3002
